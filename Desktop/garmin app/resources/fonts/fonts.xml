<?xml version="1.0"?>
<resources>
    <!-- Use NotoSansHebrew system vector font (built into fr165m, instinct3 AMOLED) -->
    <!-- For devices that have it as a system_ttf, we reference it by name via Graphics.getVectorFont() -->
    <!-- Fallback bitmap fonts for devices without it (instinct3solar) -->
    <font id="HebrewSmall"  filename="HebrewSmall.fnt"  />
    <font id="HebrewMedium" filename="HebrewMedium.fnt" />
    <font id="HebrewLarge"  filename="HebrewLarge.fnt"  />

    <!-- Glance-scoped copies (same bitmaps) so the glance process can load them. -->
    <font id="HebrewGlanceSmall"  filename="HebrewSmall.fnt"  scope="glance" />
    <font id="HebrewGlanceMedium" filename="HebrewMedium.fnt" scope="glance" />
</resources>
