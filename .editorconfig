root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Several files intentionally group small related declarations (e.g. geometry
# model types) in one file, so the one-class-per-file rule is relaxed.
ktlint_standard_filename = disabled
# KDoc and a few descriptive lines run long; don't fail the build on length.
ktlint_standard_max-line-length = disabled
ktlint_function_naming_ignore_when_annotated_with = Composable, Test
